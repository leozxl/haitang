
<!-- favicon -->
<link rel="shortcut icon" href={config.site.favicon} />
<!-- theme meta -->
<meta name="theme-name" content="haitang" />
<meta name="msapplication-TileColor" content="#000000" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000" />
<meta name="generator" content={Astro.generator} />
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<meta name="baidu-site-verification" content="codeva-9OKHetOhJD" />
<meta name="baidu-site-verification" content="codeva-AQ562KBLsj" />
<meta name="google-site-verification" content="SrjSGoQVZSvEWvoJLRsRRqB6yZaCjX91vNTJwTdHLy8" />


<!-- responsive meta -->
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, maximum-scale=5"
/>


<!-- title -->
<title>
  {pageTitle}
</title>


<!-- canonical url -->
<link rel="canonical" href={canonicalUrl} item-prop="url" />


<!-- noindex robots -->
{shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
